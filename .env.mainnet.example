# ==============================================================================
# Equity Catalyst - Solana Mainnet-Beta Production Configuration
# ==============================================================================
APP_ENV=mainnet
EQUITY_ENV=mainnet
SOLANA_CLUSTER=mainnet-beta

# Production High-Throughput Solana RPC (Helius / Triton / QuickNode)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_MAINNET_WS_URL=wss://api.mainnet-beta.solana.com
SOLANA_FALLBACK_RPC_URLS=https://solana-mainnet.g.alchemy.com/v2/demo,https://rpc.ankr.com/solana,https://api.mainnet-beta.solana.com
SOLANA_RPC_TIMEOUT_MS=15000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/equity_catalyst_mainnet
REDIS_URL=redis://127.0.0.1:6379

API_HOST=0.0.0.0
API_PORT=4000
JUPITER_API_URL=https://quote-api.jup.ag/v6
PYTH_HERMES_URL=https://hermes.pyth.network

# Isolated Execution Signer (Constrained keeper operational wallet)
EXECUTION_SIGNER_PATH=/etc/equity-catalyst/mainnet-signer.json
# Secure Default: Simulation-only until explicitly enabled by authorized multisig
EXECUTION_READ_ONLY=true

# Conservative Production Limits (Step 08.9)
MAX_TRADE_SIZE_USD=25000
MAX_SLIPPAGE_BPS=30
