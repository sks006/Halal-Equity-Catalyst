# ==============================================================================
# Equity Catalyst - Local Development Environment Configuration
# ==============================================================================
APP_ENV=development
EQUITY_ENV=development
SOLANA_CLUSTER=localnet

SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_WS_URL=ws://127.0.0.1:8900
DATABASE_URL=postgres://postgres:postgres@localhost:5432/equity_catalyst_dev
REDIS_URL=redis://127.0.0.1:6379

API_HOST=127.0.0.1
API_PORT=4000
JUPITER_API_URL=https://quote-api.jup.ag/v6
PYTH_HERMES_URL=https://hermes.pyth.network

EXECUTION_SIGNER_PATH=~/.config/solana/id.json
EXECUTION_READ_ONLY=false
MAX_TRADE_SIZE_USD=100000
MAX_SLIPPAGE_BPS=100
