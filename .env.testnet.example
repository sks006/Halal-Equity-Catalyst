# ==============================================================================
# Equity Catalyst - Solana Devnet / Testnet Environment Configuration
# ==============================================================================
APP_ENV=testnet
EQUITY_ENV=testnet
SOLANA_CLUSTER=devnet

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
DATABASE_URL=postgres://postgres:postgres@localhost:5432/equity_catalyst
REDIS_URL=redis://127.0.0.1:6379

API_HOST=127.0.0.1
API_PORT=4000
JUPITER_API_URL=https://quote-api.jup.ag/v6
PYTH_HERMES_URL=https://hermes.pyth.network

EXECUTION_SIGNER_PATH=~/.config/solana/id.json
EXECUTION_READ_ONLY=true
MAX_TRADE_SIZE_USD=50000
MAX_SLIPPAGE_BPS=50
